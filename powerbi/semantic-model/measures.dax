// =====================================================================================
//  FinSight — Mesures DAX du modèle sémantique sm_finsight (Direct Lake)
// =====================================================================================
//  COMMENT LES AJOUTER EN UNE FOIS
//   1. Ouvrir le modèle sémantique sm_finsight (Fabric → « Ouvrir le modèle de données »)
//      ou Power BI Desktop connecté en mode édition Direct Lake.
//   2. Ouvrir la vue « Requête DAX », coller ce fichier entier, exécuter (F5).
//   3. Cliquer « Mettre à jour le modèle : ajouter de nouvelles mesures ».
//   4. Ranger ensuite les mesures en dossiers d'affichage et appliquer les formats
//      indiqués dans les commentaires « Dossier | Format » (tâche FS-45).
//
//  CONVENTION DE SIGNE : montant_pnl_eur = crédit − débit
//   → produits POSITIFS, charges NÉGATIVES. Le résultat = simple somme.
//   → Un écart (Réel − Budget) POSITIF est toujours FAVORABLE (plus de CA ou moins de charges).
// =====================================================================================

DEFINE

    // ---------------------------------------------------------------- Compte de résultat
    // Dossier : 1. Compte de résultat | Format : # ##0 €
    MEASURE fact_gl[Réel] =
        SUM ( fact_gl[montant_pnl_eur] )

    MEASURE fact_gl[CA] =
        CALCULATE ( [Réel], dim_compte[ligne_pnl] = "Chiffre d'affaires" )

    MEASURE fact_gl[Coût des ventes] =
        CALCULATE ( [Réel], dim_compte[ligne_pnl] = "Coût des ventes" )

    MEASURE fact_gl[Marge brute] =
        CALCULATE ( [Réel], dim_compte[agregat] = "Marge brute" )

    MEASURE fact_gl[Charges externes] =
        CALCULATE ( [Réel], dim_compte[ligne_pnl] = "Charges externes" )

    MEASURE fact_gl[Charges de personnel] =
        CALCULATE ( [Réel], dim_compte[ligne_pnl] = "Charges de personnel" )

    MEASURE fact_gl[EBITDA] =
        CALCULATE ( [Réel], dim_compte[agregat] IN { "Marge brute", "EBITDA" } )

    MEASURE fact_gl[Résultat d'exploitation] =
        CALCULATE ( [Réel], dim_compte[agregat] IN { "Marge brute", "EBITDA", "Résultat d'exploitation" } )

    MEASURE fact_gl[Résultat net] =
        CALCULATE ( [Réel], dim_compte[est_compte_resultat] = TRUE () )

    // Format : 0,0 %
    MEASURE fact_gl[Marge brute %] = DIVIDE ( [Marge brute], [CA] )
    MEASURE fact_gl[EBITDA %] = DIVIDE ( [EBITDA], [CA] )
    MEASURE fact_gl[Résultat net %] = DIVIDE ( [Résultat net], [CA] )
    MEASURE fact_gl[Personnel % CA] = DIVIDE ( - [Charges de personnel], [CA] )

    // Pour la matrice « Compte de résultat » : masque les comptes de bilan (ligne « Bilan »),
    // le total général de la matrice = Résultat net
    // Dossier : 1. Compte de résultat | Format : # ##0 €
    MEASURE fact_gl[Montant P&L] =
        CALCULATE ( [Réel], KEEPFILTERS ( dim_compte[est_compte_resultat] = TRUE () ) )

    // ---------------------------------------------------------------- Budget
    // Dossier : 2. Budget | Format : # ##0 €
    MEASURE fact_budget[Budget] =
        SUM ( fact_budget[budget_pnl_eur] )

    MEASURE fact_budget[CA Budget] =
        CALCULATE ( [Budget], dim_compte[ligne_pnl] = "Chiffre d'affaires" )

    MEASURE fact_budget[EBITDA Budget] =
        CALCULATE ( [Budget], dim_compte[agregat] IN { "Marge brute", "EBITDA" } )

    MEASURE fact_budget[Résultat net Budget] =
        CALCULATE ( [Budget], dim_compte[est_compte_resultat] = TRUE () )

    MEASURE fact_budget[Écart budget] =
        [Réel] - [Budget]

    // Format : +0,0 %;-0,0 %;0,0 %
    MEASURE fact_budget[Écart budget %] =
        DIVIDE ( [Écart budget], ABS ( [Budget] ) )

    MEASURE fact_budget[Taux de réalisation CA] =
        DIVIDE ( [CA], [CA Budget] )

    // Réel limité aux mois clôturés : évite de comparer un budget annuel à un réel partiel
    MEASURE fact_budget[Budget à date] =
        CALCULATE ( [Budget], KEEPFILTERS ( dim_date[est_avant_arrete] = TRUE () ) )

    MEASURE fact_budget[Écart budget à date] =
        [Réel] - [Budget à date]

    // Format : texte (icône conditionnelle) — ▲ favorable / ▼ défavorable
    MEASURE fact_budget[Écart budget indicateur] =
        VAR _e = [Écart budget à date]
        RETURN IF ( ISBLANK ( _e ), BLANK (), IF ( _e >= 0, "▲", "▼" ) )

    // ---------------------------------------------------------------- Intelligence temporelle
    // Dossier : 3. Temps | Format : # ##0 €
    MEASURE fact_gl[CA YTD] = TOTALYTD ( [CA], dim_date[date] )
    MEASURE fact_gl[EBITDA YTD] = TOTALYTD ( [EBITDA], dim_date[date] )
    MEASURE fact_gl[Résultat net YTD] = TOTALYTD ( [Résultat net], dim_date[date] )
    MEASURE fact_gl[Réel YTD] = TOTALYTD ( [Réel], dim_date[date] )
    MEASURE fact_budget[Budget YTD] = TOTALYTD ( [Budget à date], dim_date[date] )
    MEASURE fact_budget[Écart YTD] = [Réel YTD] - [Budget YTD]

    MEASURE fact_gl[CA N-1] = CALCULATE ( [CA], SAMEPERIODLASTYEAR ( dim_date[date] ) )
    MEASURE fact_gl[EBITDA N-1] = CALCULATE ( [EBITDA], SAMEPERIODLASTYEAR ( dim_date[date] ) )
    MEASURE fact_gl[Résultat net N-1] = CALCULATE ( [Résultat net], SAMEPERIODLASTYEAR ( dim_date[date] ) )
    MEASURE fact_gl[CA YTD N-1] = CALCULATE ( [CA YTD], SAMEPERIODLASTYEAR ( dim_date[date] ) )

    // Format : +0,0 %;-0,0 %;0,0 %
    MEASURE fact_gl[CA Var N-1 %] = DIVIDE ( [CA] - [CA N-1], [CA N-1] )
    MEASURE fact_gl[EBITDA Var N-1 %] = DIVIDE ( [EBITDA] - [EBITDA N-1], ABS ( [EBITDA N-1] ) )

    MEASURE fact_gl[CA 12 mois glissants] =
        CALCULATE ( [CA], DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -12, MONTH ) )

    // ---------------------------------------------------------------- Dates utilitaires
    // Dossier : 9. Utilitaires | Format : jj/mm/aaaa
    MEASURE fact_gl[Date d'arrêté] =
        CALCULATE ( MAX ( dim_date[date] ), REMOVEFILTERS ( dim_date ), dim_date[est_avant_arrete] = TRUE () )

    // Dernier jour de la période sélectionnée, plafonné à la date d'arrêté
    MEASURE fact_gl[Date de référence] =
        MIN ( MAX ( dim_date[date] ), [Date d'arrêté] )

    // ---------------------------------------------------------------- Créances clients
    // Dossier : 4. Créances clients | Format : # ##0 €
    MEASURE fact_factures_clients[CA facturé TTC] =
        SUM ( fact_factures_clients[montant_ttc_eur] )

    // Encours « à date » : factures émises avant la date de référence et non réglées à cette date
    MEASURE fact_factures_clients[Encours clients] =
        VAR _d = [Date de référence]
        RETURN
            CALCULATE (
                SUM ( fact_factures_clients[montant_ttc_eur] ),
                REMOVEFILTERS ( dim_date ),
                fact_factures_clients[date_facture] <= _d,
                ISBLANK ( fact_factures_clients[date_paiement] )
                    || fact_factures_clients[date_paiement] > _d
            )

    MEASURE fact_factures_clients[Encours clients échu] =
        VAR _d = [Date de référence]
        RETURN
            CALCULATE (
                SUM ( fact_factures_clients[montant_ttc_eur] ),
                REMOVEFILTERS ( dim_date ),
                fact_factures_clients[date_facture] <= _d,
                fact_factures_clients[date_echeance] < _d,
                ISBLANK ( fact_factures_clients[date_paiement] )
                    || fact_factures_clients[date_paiement] > _d
            )

    // Format : 0,0 %
    MEASURE fact_factures_clients[% Encours échu] =
        DIVIDE ( [Encours clients échu], [Encours clients] )

    // DSO méthode « comptable » : encours / CA TTC des 90 derniers jours × 90
    // Format : 0 « j »
    MEASURE fact_factures_clients[DSO (jours)] =
        VAR _d = [Date de référence]
        VAR _ca90 =
            CALCULATE ( [CA facturé TTC], DATESINPERIOD ( dim_date[date], _d, -90, DAY ) )
        RETURN DIVIDE ( [Encours clients], _ca90 ) * 90

    // Balance âgée figée à la date d'arrêté (utiliser avec fact_factures_clients[tranche_age])
    MEASURE fact_factures_clients[Encours à l'arrêté] =
        CALCULATE (
            SUM ( fact_factures_clients[montant_ttc_eur] ),
            REMOVEFILTERS ( dim_date ),
            fact_factures_clients[est_ouverte] = TRUE ()
        )

    // Format : 0
    MEASURE fact_factures_clients[Nb factures ouvertes] =
        CALCULATE ( COUNTROWS ( fact_factures_clients ), REMOVEFILTERS ( dim_date ), fact_factures_clients[est_ouverte] = TRUE () )

    // Retard moyen pondéré par le montant des factures réglées sur la période (en jours)
    // Format : 0,0
    MEASURE fact_factures_clients[Retard moyen de paiement (jours)] =
        CALCULATE (
            DIVIDE (
                SUMX ( fact_factures_clients, fact_factures_clients[jours_retard] * fact_factures_clients[montant_ttc_eur] ),
                SUM ( fact_factures_clients[montant_ttc_eur] )
            ),
            fact_factures_clients[est_ouverte] = FALSE ()
        )

    // Encaissements de la période (relation inactive sur la date de paiement)
    MEASURE fact_factures_clients[Encaissements clients] =
        CALCULATE (
            SUM ( fact_factures_clients[montant_ttc_eur] ),
            USERELATIONSHIP ( fact_factures_clients[date_paiement_key], dim_date[date_key] )
        )

    // ---------------------------------------------------------------- Dettes fournisseurs
    // Dossier : 5. Dettes fournisseurs | Format : # ##0 €
    MEASURE fact_factures_fournisseurs[Achats TTC] =
        SUM ( fact_factures_fournisseurs[montant_ttc_eur] )

    MEASURE fact_factures_fournisseurs[Encours fournisseurs] =
        VAR _d = [Date de référence]
        RETURN
            CALCULATE (
                SUM ( fact_factures_fournisseurs[montant_ttc_eur] ),
                REMOVEFILTERS ( dim_date ),
                fact_factures_fournisseurs[date_facture] <= _d,
                ISBLANK ( fact_factures_fournisseurs[date_paiement] )
                    || fact_factures_fournisseurs[date_paiement] > _d
            )

    // Format : 0 « j »
    MEASURE fact_factures_fournisseurs[DPO (jours)] =
        VAR _d = [Date de référence]
        VAR _achats90 =
            CALCULATE ( [Achats TTC], DATESINPERIOD ( dim_date[date], _d, -90, DAY ) )
        RETURN DIVIDE ( [Encours fournisseurs], _achats90 ) * 90

    MEASURE fact_factures_fournisseurs[Décaissements fournisseurs] =
        CALCULATE (
            SUM ( fact_factures_fournisseurs[montant_ttc_eur] ),
            USERELATIONSHIP ( fact_factures_fournisseurs[date_paiement_key], dim_date[date_key] )
        )

    // ---------------------------------------------------------------- Trésorerie & BFR
    // Dossier : 6. Trésorerie | Format : # ##0 €
    // Remarque : mouvements convertis au taux moyen du mois (approximation documentée, cf. FS-75)
    MEASURE fact_gl[Trésorerie] =
        VAR _d = [Date de référence]
        RETURN
            CALCULATE (
                SUM ( fact_gl[montant_eur] ),
                dim_compte[numero_compte] = "512000",
                REMOVEFILTERS ( dim_date ),
                dim_date[date] <= _d
            )

    MEASURE fact_gl[Variation de trésorerie] =
        CALCULATE ( SUM ( fact_gl[montant_eur] ), dim_compte[numero_compte] = "512000" )

    MEASURE fact_gl[Entrées de trésorerie] =
        CALCULATE ( SUM ( fact_gl[debit_eur] ), dim_compte[numero_compte] = "512000", fact_gl[journal] <> "AN" )

    MEASURE fact_gl[Sorties de trésorerie] =
        CALCULATE ( - SUM ( fact_gl[credit_eur] ), dim_compte[numero_compte] = "512000" )

    MEASURE fact_gl[BFR clients - fournisseurs] =
        [Encours clients] - [Encours fournisseurs]

    // ---------------------------------------------------------------- Titres dynamiques
    // Dossier : 9. Utilitaires
    MEASURE fact_gl[Titre rapport] =
        "FinSight — données arrêtées au " & FORMAT ( [Date d'arrêté], "dd/mm/yyyy" )

    MEASURE fact_gl[Libellé période] =
        VAR _min = MIN ( dim_date[date] )
        VAR _max = MIN ( MAX ( dim_date[date] ), [Date d'arrêté] )
        RETURN FORMAT ( _min, "mmm yyyy" ) & " → " & FORMAT ( _max, "mmm yyyy" )

// Requête de contrôle : exécutée avec les définitions ci-dessus
EVALUATE
SUMMARIZECOLUMNS (
    dim_date[annee],
    "CA", [CA],
    "Budget CA", [CA Budget],
    "EBITDA", [EBITDA],
    "EBITDA %", [EBITDA %],
    "Résultat net", [Résultat net],
    "DSO (jours)", [DSO (jours)],
    "DPO (jours)", [DPO (jours)],
    "Trésorerie", [Trésorerie]
)
ORDER BY dim_date[annee]
