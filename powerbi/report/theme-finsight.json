{
  "name": "FinSight",
  "dataColors": ["#1F4E79", "#2E86AB", "#F6AE2D", "#86BBD8", "#33658A", "#758E4F", "#F26419", "#9B5DE5"],
  "background": "#FFFFFF",
  "foreground": "#1B1B1F",
  "tableAccent": "#1F4E79",
  "good": "#2E7D32",
  "neutral": "#F6AE2D",
  "bad": "#C62828",
  "maximum": "#1F4E79",
  "center": "#86BBD8",
  "minimum": "#E8F1F8",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1B1B1F" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1B1B1F" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4A4A55" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1F4E79" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E6EA" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontSize": 12, "fontColor": { "solid": { "color": "#1B1B1F" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }]
      }
    }
  }
}
